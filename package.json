{
  "name": "pptx2js",
  "version": "1.0.0",
  "description": "Convert .pptx files to PptxGenJS scripts and recreated .pptx files",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pptx2js": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "pptx",
    "powerpoint",
    "pptxgenjs",
    "converter",
    "ooxml"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.1.0",
    "fast-xml-parser": "^4.3.2",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
